{
  "buildCommand": "node scripts/sync-panel.mjs",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/((?!camadas/|camada-detalle).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' https://www.googletagmanager.com 'unsafe-hashes' 'sha256-1jAmyYXcRq6zFldLe/GCgIDJBiOONdXjTLgEFMDnDSM='; default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.web3forms.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; media-src 'self'; connect-src 'self' https://api.web3forms.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/camadas/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' https://www.googletagmanager.com 'unsafe-inline'; default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.web3forms.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; media-src 'self'; connect-src 'self' https://api.web3forms.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/camada-detalle",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' https://www.googletagmanager.com 'unsafe-inline'; default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.web3forms.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; media-src 'self'; connect-src 'self' https://api.web3forms.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(assets/sitio|scripts)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/imagenes_panel/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/imagenes_caniches/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(favicon-32.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "tienda.deterrajaras.es" }],
      "destination": "https://deterrajaras.es/",
      "permanent": true
    },
    {
      "source": "/pages/camadas",
      "has": [{ "type": "host", "value": "tienda.deterrajaras.es" }],
      "destination": "https://deterrajaras.es/camadas",
      "permanent": true
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "tienda.deterrajaras.es" }],
      "destination": "/api/gone",
      "permanent": false
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "tienda.deterrajaras.es" }],
      "destination": "/api/gone",
      "permanent": false
    },
    {
      "source": "/blog/perros-hipoalergenicos-peque%C3%B1os",
      "destination": "/blog/perros-hipoalergenicos-pequenos",
      "permanent": true
    },
    {
      "source": "/blog/perros-hipoalergenicos-pequeños",
      "destination": "/blog/perros-hipoalergenicos-pequenos",
      "permanent": true
    },
    {
      "source": "/camada-detalle",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "1"
        }
      ],
      "destination": "/camadas/caniche-toy-julio-2026",
      "permanent": true
    },
    {
      "source": "/camada-detalle",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "2"
        }
      ],
      "destination": "/camadas/schnauzer-mini-mayo-2026",
      "permanent": true
    },
    {
      "source": "/camada-detalle",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "4"
        }
      ],
      "destination": "/camadas/schnauzer-mini-junio-2026",
      "permanent": true
    },
    {
      "source": "/schnauzer-mini.html",
      "destination": "/schnauzer-mini",
      "permanent": true
    },
    {
      "source": "/caniche-toy.html",
      "destination": "/caniche-toy",
      "permanent": true
    },
    {
      "source": "/aviso-legal.html",
      "destination": "/aviso-legal",
      "permanent": true
    },
    {
      "source": "/politica-privacidad.html",
      "destination": "/politica-privacidad",
      "permanent": true
    },
    {
      "source": "/camadas.html",
      "destination": "/camadas",
      "permanent": true
    },
    {
      "source": "/test-raza.html",
      "destination": "/test-raza",
      "permanent": true
    },
    {
      "source": "/caniche-toy-extremadura.html",
      "destination": "/caniche-toy-extremadura",
      "permanent": true
    },
    {
      "source": "/schnauzer-mini-extremadura.html",
      "destination": "/schnauzer-mini-extremadura",
      "permanent": true
    },
    {
      "source": "/cachorros-madrid.html",
      "destination": "/cachorros-madrid",
      "permanent": true
    },
    {
      "source": "/criadero-caceres.html",
      "destination": "/criadero-caceres",
      "permanent": true
    },
    {
      "source": "/criadero-extremadura.html",
      "destination": "/criadero-caceres",
      "permanent": true
    },
    {
      "source": "/criadero-extremadura",
      "destination": "/criadero-caceres",
      "permanent": true
    },
    {
      "source": "/blog/como-comprar-un-cachorro.html",
      "destination": "/blog/como-comprar-un-cachorro",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/schnauzer-miniatura-pierde-pelo",
      "destination": "/blog/schnauzer-miniatura-suelta-pelo",
      "permanent": true
    },
    {
      "source": "/blog/como-saber-si-un-criador-de-perros-is-legal",
      "destination": "/blog/como-saber-si-un-criador-de-perros-es-legal",
      "permanent": true
    },
    {
      "source": "/blog/curso-obligatorio-tener-perro",
      "destination": "/blog/curso-obligatorio-para-tener-perro",
      "permanent": true
    },
    {
      "source": "/blog/caniche-toy-schnauzer-mini",
      "destination": "/blog/caniche-toy-o-schnauzer-mini",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "tienda.deterrajaras.es" }],
      "destination": "/api/gone"
    }
  ]
}
